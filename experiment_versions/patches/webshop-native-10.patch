+            "click[buy now]",
+            report("A"),
+            report("B independent"),
+        ]
+    )
+    execute(e, node("a"))
+    execute(e, node("b"))
+    b_prompt = json.dumps(b.calls[-1]["messages"])
+    assert "PRIVATE_s1" not in b_prompt and "only A" not in b_prompt
+    assert "PRIVATE_s2" in b_prompt
+    assert life.allows_agent("a") and life.allows_agent("b")
