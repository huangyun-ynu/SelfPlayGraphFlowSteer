+# Review-only LASER-inspired checklist profile; not the adopted baseline.
+# See docs/WEBSHOP_LASER_CHECKLIST_ADAPTATION.zh-CN.md.
+# Canonical deployment configuration for the seven-dataset formal PATS run.
+# Credentials are loaded from the repository .env and are never stored here.
+[models.proposer]
+base_url = "http://127.0.0.1:18601/v1"
+api_key = "EMPTY"
+served_model = "Qwen3.5-9B"
+base_model_path = "models/Qwen3.5-9B"
+checkpoint_path = "state/formal-training/checkpoints/proposer"
+trainable = true
+
+[models.solver]
+base_url = "http://127.0.0.1:18602/v1"
+api_key = "EMPTY"
+served_model = "Qwen3.5-9B"
+base_model_path = "models/Qwen3.5-9B"
+checkpoint_path = "state/formal-training/checkpoints/solver"
+trainable = true
+
+[runtime]
+name = "default"
+base_url = "http://127.0.0.1:18603/v1"
+api_key = "EMPTY"
+served_model = "Qwen3.5-9B"
+timeout_s = 120.0
+max_concurrency = 12
+managed_locally = false
+frozen = true
+network_path = "direct"
+request_profile = "qwen"
+
+[runtime_routing]
+# Use the two existing Codex endpoints; judge aliases share the same pool.
+worker_routes = ["deepseek"]
+skill_distiller = "skill_refiner"
+health_cooldown_s = 600.0
+pool_retry_attempts = 2
+pool_retry_backoff_s = 1.0
+pool_member_queue_wait_s = 0.5
+
+[runtime_routing.endpoint_pools]
+gpt = ["gpt", "gpt_eco", "gpt_student"]
+gpt_judge = ["gpt_judge", "gpt_judge_eco"]
+
+[canvas]
+# Predictive admission protection is disabled; hard token and wall-clock limits remain.
+remaining_time_admission_enabled = false
+remaining_token_admission_enabled = false
+max_agents = 4
+max_rounds = 24
+relay_max_chars = 1000
+
+[canvas.max_total_tokens_by_dataset]
+aime = 65536
+nq_open = 65536
+hotpotqa = 65536
+webshop = 350000
+alfworld = 350000
+healthbench_professional = 65536
+swe_bench = 350000
+
+[solver_skillbank]
+path = "state/formal-training/runtime_state/director_skillbank.v2.json"
+cases_path = "state/formal-training/runtime_state/director_skill_cases.json"
+usage = "off"
+prompt_token_budget = 1024
+retrieve_top_k = 3
+enabled = false
+mode = "director_skill_v2"
+activation_policy = "checked"
+embedding_model_path = "models/e5-base-v2"
+
+[solver_skillbank.pats]
+enabled = false
+ema_alpha = 0.1
+revise_threshold = 0.3
+compress_threshold = 0.85
+max_skills = 30
+max_tokens = 2000
+min_groups = 2
+min_evidence_cards = 2
+review_interval = 1
+max_edits = 4
+max_reviews_per_cycle = 3
+max_evidence_groups = 32
+max_policy_lag = 1
+max_review_input_tokens = 20480
+
+[trace]
+path = "state/formal-training/runtime_state/traces.jsonl"
+
+[verifier]
+mode = "auto"
+
+[answer_submission]
+enabled = true
+qa_model_enabled = true
+runtime_route = "gpt"
+max_tokens = 128
+require_source_span = true
+
+# Pure-local Python execution support for AIME Workers.
+[aime_actions]
+enabled = true
+timeout_s = 5.0
+max_output_chars = 8000
+max_code_chars = 12000
+memory_limit_mb = 1024
+max_initial_calls = 3
+max_revision_calls = 1
+max_total_calls = 4
+
+# Pinned Search-R1 Wiki-18 E5/FAISS service used by NQ-open.
+# HotpotQA follows FlowSteer: its dataset-provided distractor context is used directly.
+# The launcher validates the backend identity before admitting formal runs.
+[retrieval]
+enabled = true
+service_url = "http://127.0.0.1:18010/retrieve"
+top_k = 5
+timeout_s = 240.0
+max_tool_rounds = 3
+
+# The formal launcher owns the pinned official WebShop sidecar on port 18020.
+[webshop]
+enabled = true
+service_url = "http://127.0.0.1:18020"
+timeout_s = 240.0
+max_observation_chars = 0
+max_query_chars = 500
+max_initial_calls = 12
+max_revision_calls = 4
+max_total_calls = 16
+staged_commit_enabled = true
+max_pending_sessions = 8
+pending_ttl_s = 900.0
+# Promoted baseline: 62/128 strict successes; see docs/WEBSHOP_BASELINE.zh-CN.md.
+search_observation_mode = "legacy"
+worker_guidance_policy = "laser_checklist_v1"
+
+# Local assets are present; the formal environment installs the alfworld extra.
+[alfworld]
+enabled = true
+data_root = "assets/alfworld-data/json_2.1.1"
+max_episode_steps = 50
+max_rollout_steps = 200
+max_observation_chars = 12000
+max_initial_calls = 50
+max_revision_calls = 50
+max_total_calls = 100
+worker_guidance_policy = "factual_memory_v1"
+
+# Local execution storage, trusted remote verifier identity, registry, and
+# pinned dataset revision are provisioned for the formal run.
+[swe]
+enabled = true
+repo_cache_root = "state/formal-training/swe/repo-cache"
+workspace_root = "state/formal-training/swe/workspaces"
+artifact_store_root = "state/formal-training/private/swe/artifacts"
+verifier_registry_path = "state/formal-training/private/swe/verifier-registry.json"
+lifecycle_log_path = "state/formal-training/private/swe/lifecycle.jsonl"
+verifier_log_path = "state/formal-training/private/swe/verifier-client.jsonl"
+verifier_host = "43.134.20.27"
+verifier_user = "sweeval"
+verifier_identity_file = "state/formal-training/private/swe/identity"
+verifier_known_hosts_file = "state/formal-training/private/swe/known_hosts"
+# Optional Tencent Cloud CVM lifecycle. Enable both flags only after exporting
+# TENCENTCLOUD_SECRET_ID and TENCENTCLOUD_SECRET_KEY in the private .env.
+cvm_auto_start = false
+cvm_auto_stop = false
+cvm_region = "ap-singapore"
+cvm_instance_id = "ins-5n1zolfw"
+cvm_secret_id_env = "TENCENTCLOUD_SECRET_ID"
+cvm_secret_key_env = "TENCENTCLOUD_SECRET_KEY"
+cvm_endpoint = "cvm.tencentcloudapi.com"
+cvm_timeout_s = 600.0
+cvm_poll_s = 5.0
+dataset_revision = "78f471bf655a3137b2e8a75af1501690ec009ec3"
+local_test_timeout_s = 60.0
+max_output_chars = 12000
+max_file_chars = 200000
+max_patch_bytes = 2000000
+max_initial_calls = 20
+max_revision_calls = 12
+max_total_calls = 32
+duplicate_responsibility_policy = "record_only"
+
+[swe.test_profiles]
+python_syntax = ["python", "-m", "py_compile"]
+
+[healthbench_judge_audit]
+path = "state/formal-training/private/healthbench_judge"
+runtime_route = "gpt_student"
+expected_model = "gpt-5.5"
+
+[resources]
+proposer_gpu_id = 1
+solver_gpu_id = 1
+# Validation metadata for this evaluation-only profile; the launcher uses existing services.
+allocated_gpu_ids = [1]
+allow_policy_gpu_colocation = true
+proposer_service_gpu_memory_utilization = 0.30
+solver_service_gpu_memory_utilization = 0.30
+
+# Dedicated between-cycle Skill Distiller route.
+[runtimes.skill_refiner]
+base_url = "https://nexus.itssx.com/api/codex/codex_pro/v1"
+api_key_env = "NEXUS_PRO_API_KEY"
+served_model = "gpt-6-astra"
+request_profile = "generic"
+api_surface = "chat_completions"
+network_path = "direct"
+max_concurrency = 20
+timeout_s = 240.0
+max_tokens = 4096
+managed_locally = false
+frozen = true
+
+[runtimes.gpt]
+base_url = "https://nexus.itssx.com/api/codex/codex/v1"
+api_key_env = "NEXUS_API_KEY"
+served_model = "gpt-5.5"
+request_profile = "generic"
+api_surface = "chat_completions"
+network_path = "direct"
+reasoning_effort = "low"
+max_concurrency = 10
+timeout_s = 240.0
+max_tokens = 16384
+managed_locally = false
+frozen = true
+
+[runtimes.gpt_eco]
+base_url = "https://nexus.itssx.com/api/codex_eco/v1"
+api_key_env = "NEXUS_API_KEY"
+served_model = "gpt-5.5"
+request_profile = "generic"
+api_surface = "chat_completions"
+network_path = "direct"
+reasoning_effort = "low"
+max_concurrency = 10
+timeout_s = 240.0
+max_tokens = 16384
+managed_locally = false
