+cvm_secret_id_env = "TENCENTCLOUD_SECRET_ID"
+cvm_secret_key_env = "TENCENTCLOUD_SECRET_KEY"
+cvm_endpoint = "cvm.tencentcloudapi.com"
+cvm_timeout_s = 600.0
+cvm_poll_s = 5.0
+dataset_revision = "78f471bf655a3137b2e8a75af1501690ec009ec3"
+local_test_timeout_s = 60.0
+max_output_chars = 12000
+max_file_chars = 200000
+max_patch_bytes = 2000000
+max_initial_calls = 20
+max_revision_calls = 12
+max_total_calls = 32
+duplicate_responsibility_policy = "record_only"
+
+[swe.test_profiles]
+python_syntax = ["python", "-m", "py_compile"]
+
+[healthbench_judge_audit]
+path = "state/formal-training/private/healthbench_judge"
+runtime_route = "gpt_student"
+expected_model = "gpt-5.5"
+
+[resources]
