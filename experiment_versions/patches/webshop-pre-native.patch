+# WebShop environment-feedback ablation against the official legacy baseline.
+# Canonical deployment configuration for the seven-dataset formal PATS run.
+# Credentials are loaded from the repository .env and are never stored here.
+[models.proposer]
+base_url = "http://127.0.0.1:18601/v1"
+api_key = "EMPTY"
+served_model = "Qwen3.5-9B"
+base_model_path = "models/Qwen3.5-9B"
+checkpoint_path = "state/formal-training/checkpoints/proposer"
+trainable = true
+
+[models.solver]
+base_url = "http://127.0.0.1:18602/v1"
+api_key = "EMPTY"
+served_model = "Qwen3.5-9B"
+base_model_path = "models/Qwen3.5-9B"
+checkpoint_path = "state/formal-training/checkpoints/solver"
+trainable = true
+
+[runtime]
+name = "default"
+base_url = "http://127.0.0.1:18603/v1"
+api_key = "EMPTY"
+served_model = "Qwen3.5-9B"
+timeout_s = 120.0
+max_concurrency = 12
+managed_locally = false
+frozen = true
+network_path = "direct"
+request_profile = "qwen"
+
+[runtime_routing]
+# Use the two existing Codex endpoints; judge aliases share the same pool.
+worker_routes = ["deepseek"]
+skill_distiller = "skill_refiner"
+health_cooldown_s = 600.0
+pool_retry_attempts = 2
+pool_retry_backoff_s = 1.0
+pool_member_queue_wait_s = 0.5
+
+[runtime_routing.endpoint_pools]
+gpt = ["gpt", "gpt_eco", "gpt_student"]
+gpt_judge = ["gpt_judge", "gpt_judge_eco"]
+
+[canvas]
+# Predictive admission protection is disabled; hard token and wall-clock limits remain.
+remaining_time_admission_enabled = false
+remaining_token_admission_enabled = false
+max_agents = 4
+max_rounds = 24
+relay_max_chars = 1000
+
+[canvas.max_total_tokens_by_dataset]
+aime = 65536
+nq_open = 65536
+hotpotqa = 65536
+webshop = 350000
+alfworld = 350000
+healthbench_professional = 65536
+swe_bench = 350000
