+max_evidence_groups = 32
+max_policy_lag = 1
+max_review_input_tokens = 20480
+
+[trace]
+path = "state/formal-training/runtime_state/traces.jsonl"
+
+[verifier]
+mode = "auto"
+
+[answer_submission]
+enabled = true
+qa_model_enabled = true
+runtime_route = "gpt"
+max_tokens = 128
+require_source_span = true
+
+# Pure-local Python execution support for AIME Workers.
+[aime_actions]
+enabled = true
+timeout_s = 5.0
+max_output_chars = 8000
+max_code_chars = 12000
+memory_limit_mb = 1024
+max_initial_calls = 3
+max_revision_calls = 1
+max_total_calls = 4
+
+# Pinned Search-R1 Wiki-18 E5/FAISS service used by NQ-open.
+# HotpotQA follows FlowSteer: its dataset-provided distractor context is used directly.
+# The launcher validates the backend identity before admitting formal runs.
+[retrieval]
+enabled = true
+service_url = "http://127.0.0.1:18010/retrieve"
+top_k = 5
+timeout_s = 240.0
+max_tool_rounds = 3
+
+# The formal launcher owns the pinned official WebShop sidecar on port 18020.
+[webshop]
+# SkillFlow-style repeated-query and return feedback; no extra environment actions.
+env_feedback_enabled = true
+enabled = true
