# External benchmark assets for formal runs
#
# Copy this file to .env (or append these assignments to the ignored .env),
# replace every /ABS/PATH placeholder, and keep the resulting file private.
# The formal launchers source .env before scripts/formal/environment.sh.
#
# Do not commit credentials, private workers, virtualenvs, product databases,
# or search indexes. HealthBench files are included in this repository because
# this experiment explicitly requested them to be versioned.

# ---------------------------------------------------------------------------
# Experiment inputs and benchmark data
# ---------------------------------------------------------------------------
# The frozen NQ and HealthBench inputs below are committed by this repository.
SPGFS_HEALTHBENCH_TEST=state/formal-data/healthbench_professional_test_128.jsonl
SPGFS_HEALTHBENCH_TRAIN=data/formal/train/healthbench_professional.jsonl
SPGFS_HEALTHBENCH_TRAIN_RAW=state/datasets/healthbench-professional/349962fd46dd02343a0d8a606491baf59154ea1a/derived/stratified-128-test-balanced-512-train-seed-20260915/spgfs_train_raw.jsonl
SPGFS_NQ_FROZEN_128=state/experiments/nq-frozen-v1/nq_open_128.jsonl

# ---------------------------------------------------------------------------
# HealthBench Professional
# ---------------------------------------------------------------------------
# The official public release exposes the test split only. The source file
# contains benchmark questions, physician answers, and rubric criteria. This
# experiment versions the files locally in Git and points the runner at them.
SPGFS_HEALTHBENCH_SOURCE=state/datasets/healthbench-professional/349962fd46dd02343a0d8a606491baf59154ea1a/test.jsonl
SPGFS_HEALTHBENCH_SOURCE_REVISION=349962fd46dd02343a0d8a606491baf59154ea1a
SPGFS_HEALTHBENCH_SOURCE_SHA256=d44b08e6e952e04c945e2c406f02533d9e7a989a84e35820ee7efdff20c9e4e2

# ---------------------------------------------------------------------------
# ALFWorld
# ---------------------------------------------------------------------------
# The complete json_2.1.1 tree is an external ~2.1 GiB asset and is not
# stored in Git. Obtain it from the approved ALFWorld release/backup, then
# set this to the directory containing train/, valid_seen/, valid_unseen/,
# and test/ (including traj_data.json and game.tw-pddl files).
SPGFS_ALFWORLD_DATA_ROOT=/ABS/PATH/alfworld-data/json_2.1.1
# The benchmark TOML reads [alfworld].data_root directly. For a formal run,
# either set that field to the same absolute path in a private local config
# copied from configs/formal_training.toml, or regenerate the static pool with
# this variable before launching the benchmark:
#   SPGFS_ALFWORLD_DATA_ROOT="$SPGFS_ALFWORLD_DATA_ROOT" \
#     python3 scripts/formal/prepare_static_eval.py

# ---------------------------------------------------------------------------
# WebShop
# ---------------------------------------------------------------------------
# Public source checkout. The pinned revision is the one used by the formal
# launcher; do not point it at an unpinned working tree.
SPGFS_WEBSHOP_SOURCE_ROOT=/ABS/PATH/webshop/source
SPGFS_WEBSHOP_SOURCE_REVISION=64fa2a5c15c7daa698b9ac93f5bb5437b634c9bd

# Independent environment and Java runtime. These are machine-specific and
# should not be committed.
SPGFS_WEBSHOP_INTERPRETER=/ABS/PATH/webshop/venv/bin/python
SPGFS_WEBSHOP_JAVA_HOME=/ABS/PATH/jdk-11.0.32.1+1

# Prepared WebShop artifacts. The database, product documents, and Lucene
# indexes are multi-gigabyte generated artifacts. Keep the matching bundle
# together and use the preparation manifest for identity checks.
SPGFS_WEBSHOP_STORE=/ABS/PATH/webshop/prepared/products.sqlite3
SPGFS_WEBSHOP_DOCUMENTS=/ABS/PATH/webshop/prepared/documents.jsonl
SPGFS_WEBSHOP_GOALS=/ABS/PATH/webshop/prepared/goals.jsonl
SPGFS_WEBSHOP_INDEX=/ABS/PATH/webshop/source/search_engine/indexes

# The official evaluation worker is private and must be supplied by the
# authorized evaluation archive. Do not replace it with a public stub when
# reporting official scores.
SPGFS_WEBSHOP_WORKER=/ABS/PATH/webshop/private-evaluation/src/skillev_private/benchmarks/official_environment_worker.py

# Expected preparation identities for the current local bundle.
SPGFS_WEBSHOP_GOALS_SHA256=630f68cb13f3ce9c1394a6b08c79947f973a91c1ba2dbe990334596f000f73dc
SPGFS_WEBSHOP_STORE_SHA256=59c0f0bde7c02673768588aaa05616b23d09f416ef62902c147bfff890837daf
SPGFS_WEBSHOP_PRODUCT_DOCUMENTS_SHA256=b990c2de08df47ea4593286767f841cc9bf04dca2cb43bf8534e430c87f940be

# WebShop sidecar port used by scripts/formal/run_experiment.sh.
SPGFS_WEBSHOP_PORT=18020

# ---------------------------------------------------------------------------
# Restore/validate commands (run manually after replacing paths)
# ---------------------------------------------------------------------------
# git clone https://github.com/princeton-nlp/WebShop.git "$SPGFS_WEBSHOP_SOURCE_ROOT"
# git -C "$SPGFS_WEBSHOP_SOURCE_ROOT" checkout "$SPGFS_WEBSHOP_SOURCE_REVISION"
# test -d "$SPGFS_ALFWORLD_DATA_ROOT/train"
# test -x "$SPGFS_WEBSHOP_INTERPRETER"
# test -s "$SPGFS_WEBSHOP_STORE"
# test -s "$SPGFS_WEBSHOP_GOALS"
# test -s "$SPGFS_WEBSHOP_WORKER"
# sha256sum "$SPGFS_WEBSHOP_GOALS" "$SPGFS_WEBSHOP_STORE"
